# Copy to .env. The app loads this checkout-local file; inherited variables take precedence.
# Never put keys in frontend files or commit .env.
PORT=4317
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# CUSTOM_MODEL_API_KEY=
# MBSE_CODEX_PATH=/absolute/path/to/codex
# MBSE_NODE=/absolute/path/to/node
# MBSE_NODE_MODULES=/absolute/path/to/node_modules
# MBSE_CHROME_PATH=/absolute/path/to/chrome
# MBSE_COMPUTER_HOSTS=github.com,docs.px4.io,nos3.readthedocs.io,example.com

# MBSE_DATA_DIR=/absolute/path/to/mbse-data
# MBSE_PYTHON=/absolute/path/to/python3
# MBSE_ENGINEERING_DEPS=/absolute/path/to/scipy-dependencies

# Optional explicitly provisioned runner; see docs/installation.md.
# MANTA_NOS3_VM_ROOT=/absolute/path/to/isolated-vm
# Optional reference fixtures are not distributed with the application.
# MANTA_STF_ASSETS_ROOT=/absolute/path/to/reference-assets
