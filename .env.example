# Copy to .env. The app loads this checkout-local file; inherited variables take precedence.
# Never put keys in frontend files or commit .env.
PORT=4317
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# CUSTOM_MODEL_API_KEY=
# DAIDALIS_CODEX_PATH=/absolute/path/to/codex
# DAIDALIS_NODE=/absolute/path/to/node
# DAIDALIS_NODE_MODULES=/absolute/path/to/node_modules
# DAIDALIS_CHROME_PATH=/absolute/path/to/chrome
# DAIDALIS_COMPUTER_HOSTS=github.com,docs.px4.io,nos3.readthedocs.io,example.com
# Public keyword search via pinned Agent Reach; Docker bundles it.
# For source startup: python3 scripts/install-agent-reach.py
# DAIDALIS_AGENT_REACH_BIN=/absolute/path/to/agent-reach
# DAIDALIS_SEARCH_TIMEOUT_MS=45000
# Model iterations per execution segment. Range 2–200.
DAIDALIS_MAX_TOOL_TURNS=128

# DAIDALIS_DATA_DIR=/absolute/path/to/mbse-data
# DAIDALIS_PYTHON=/absolute/path/to/python3
# DAIDALIS_ENGINEERING_DEPS=/absolute/path/to/scipy-dependencies

# Optional explicitly provisioned runner; see docs/installation.md.
# DAIDALIS_NOS3_VM_ROOT=/absolute/path/to/isolated-vm
# Optional reference fixtures are not distributed with the application.
# DAIDALIS_STF_ASSETS_ROOT=/absolute/path/to/reference-assets
