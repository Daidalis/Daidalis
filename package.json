{
  "name": "manta",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first model-based systems engineering agent workspace",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "desktop": "sh scripts/desktop.sh",
    "smoke": "node scripts/smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "audit:public": "node scripts/audit-public.mjs"
  },
  "optionalDependencies": {
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.307",
    "@anthropic-ai/sdk": "1.1.0",
    "@openai/agents": "0.21.0",
    "openai": "7.41.0",
    "zod": "4.6.7",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "overrides": {
    "body-parser": "2.4.0"
  }
}
